# MandiBazaar Environment Variables
# Copy to .env and fill in values

DATABASE_URL="postgresql://zulaal:zulaal@localhost:5432/zulaal?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-secret-in-production"

# ─── Stripe (customer card payments) ─────────────────────────────────────────
# Switch mode: test | live
STRIPE_MODE="test"

# TEST keys (Dashboard → Developers → API keys → Test mode)
STRIPE_SECRET_KEY_TEST="sk_test_xxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST="pk_test_xxxxxxxx"
# Webhook signing secret for test endpoint (Stripe CLI or Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET_TEST="whsec_xxxxxxxx"

# LIVE keys (Dashboard → Developers → API keys → Live mode)
STRIPE_SECRET_KEY_LIVE="sk_live_xxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE="pk_live_xxxxxxxx"
STRIPE_WEBHOOK_SECRET_LIVE="whsec_xxxxxxxx"

# Webhook URL to register in Stripe Dashboard (both test + live endpoints):
#   https://YOUR_DOMAIN/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired

# JazzCash (optional fallback if Stripe keys are empty)
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_RETURN_URL="http://localhost:3000/api/jazzcash/callback"
JAZZCASH_SANDBOX="true"
JAZZCASH_PAYMENT_URL="https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/"
JAZZCASH_ALLOW_SIMULATE="false"

# JazzCash Till / QR (manual receipt) — used until merchant API credentials arrive
JAZZCASH_QR_ENABLED="true"
JAZZCASH_TILL_ID="980803336"
JAZZCASH_TILL_MERCHANT_NAME="ybs services"
JAZZCASH_TILL_QR_IMAGE_URL="/payments/jazzcash-till-qr.jpg"

# SMS / WhatsApp (Twilio) — sign-up phone codes, admin sign-in codes, order SMS,
# rider assignment and password reset SMS.
# As soon as ACCOUNT_SID + AUTH_TOKEN + FROM_NUMBER are all set:
#   - phone verification by SMS code becomes REQUIRED at signup (customer, store, rider)
#   - coupons need a verified phone
# Without them in production, signup works without the code step (phone stays unverified)
# and coupons are not restricted. In development codes are shown on screen instead.
TWILIO_ACCOUNT_SID=""          # Twilio Console → Account Info (starts with AC…)
TWILIO_AUTH_TOKEN=""           # Twilio Console → Account Info
TWILIO_FROM_NUMBER=""          # Your Twilio phone number / sender ID in E.164, e.g. +15005550006
TWILIO_WHATSAPP_FROM=""        # optional, e.g. whatsapp:+14155238886

# Email (Resend, https://resend.com) — admin sign-in codes and order emails.
# Uses the HTTP API directly (no package). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""              # re_…
EMAIL_FROM=""                  # e.g. "MandiBazaar <no-reply@mandibazaar.pk>"


# ---------------------------------------------------------------------------
# Firebase Authentication — the source of truth for email/password login,
# email verification and password reset. REQUIRED.
# Enable: Firebase Console → Authentication → Sign-in method → Email/Password.
# Add Authorized domains: localhost + your production domain.
#
# Firebase Console → Project settings → General → Your apps → Web app (</>):
NEXT_PUBLIC_FIREBASE_API_KEY=""          # apiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""      # e.g. your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""       # projectId
NEXT_PUBLIC_FIREBASE_APP_ID=""           # appId
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""  # messagingSenderId
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON as ONE line, or base64-encode it. KEEP THIS SECRET (server only).
FIREBASE_SERVICE_ACCOUNT=""

# OpenAI (optional) — product photo vs name verification for store listings
# Without this key, sellers must still confirm photos match the product.
OPENAI_API_KEY=""
# OPENAI_VISION_MODEL="gpt-4o-mini"

# Neon Object Storage (REQUIRED on Vercel / production for images)
# No Amazon AWS account needed — these keys come from Neon Console only.
# 1) Project must be in us-east-2 or eu-central-1 (Object Storage beta regions)
# 2) Storage tab → create bucket with access public_read (e.g. mandibazaar)
# 3) Create storage credential (token_id + secret)
# Docs: https://neon.com/docs/storage/get-started
NEON_STORAGE_ACCESS_KEY=""          # Neon token_id (nak_live_…)
NEON_STORAGE_SECRET_KEY=""          # Neon s3_secret_access_key (nsk_live_…)
NEON_STORAGE_ENDPOINT="https://YOUR_BRANCH_ID.storage.c-N.us-east-2.aws.neon.tech"
NEON_STORAGE_REGION="us-east-2"
NEON_STORAGE_BUCKET="mandibazaar"

# Auto-cancel unpaid PENDING_PAYMENT orders after N minutes.
# Primary: traffic sweeps on cart/checkout (Hobby allows only 1 cron/day).
# Backup cron: /api/cron/expire-pending-payments (daily on Hobby)
PENDING_PAYMENT_TTL_MINUTES="45"
CRON_SECRET="change-me-long-random-for-vercel-cron"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MandiBazaar"
CURRENCY="PKR"
